{
  "compilerOptions": {
    "types": ["node"], 
    "target": "ES6",
    "module": "commonjs",
    "rootDir": "src",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  }
}